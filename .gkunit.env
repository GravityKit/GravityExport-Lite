# gkunit reads this in every mode, including `gkunit test --php <version>`,
# which bypasses .gkunit.matrix.yml entirely (CLI flags override the matrix file).
# CI runs the per-PHP form, so the pin has to live here or CI gets PHPUnit 9.
#
# PHPUnit 8 is required: composer.json pins phpunit/phpunit 8.5.* and
# 10up/wp_mock 0.4.2, whose TestCase calls getAnnotations() — removed in PHPUnit 9.
PHPUNIT_VERSION=8
